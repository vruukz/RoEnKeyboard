<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/candidate_bar_height"
    android:orientation="horizontal"
    android:background="@color/candidate_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/candidate0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/candidate_text"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:padding="4dp" />

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3A3F44" />

        <TextView
            android:id="@+id/candidate1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/candidate_text_best"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:padding="4dp" />

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3A3F44" />

        <TextView
            android:id="@+id/candidate2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/candidate_text"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:padding="4dp" />

    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3A3F44" />

    <ImageButton
        android:id="@+id/btnToggleKeyboard"
        android:layout_width="@dimen/candidate_bar_height"
        android:layout_height="match_parent"
        android:background="@drawable/key_bg"
        android:src="@drawable/ic_keyboard"
        android:contentDescription="@string/toggle_keyboard"
        android:padding="8dp"
        android:scaleType="fitCenter" />

</LinearLayout>
