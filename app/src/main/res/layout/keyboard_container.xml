<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_bg">

    <include layout="@layout/candidates_bar" />

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/keyboard_bg"
        android:keyBackground="@drawable/key_bg"
        android:keyTextColor="@color/key_text"
        android:keyTextSize="20sp"
        android:labelTextSize="14sp"
        android:popupLayout="@layout/popup_keyboard"
        android:shadowColor="#00000000"
        android:shadowRadius="0" />

</LinearLayout>
